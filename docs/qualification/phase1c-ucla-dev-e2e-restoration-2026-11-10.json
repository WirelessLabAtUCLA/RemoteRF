  "final_local_check_source": "from pathlib import Path\nfrom importlib.metadata import version\nimport hashlib,json,subprocess,time,zipfile,yaml\nbase=Path('/tmp/remoterf-phase1c-e2e-20261110')\nartifacts=Path('/tmp/remoterf-phase1c-radio-final-20261109')\ndef show(unit):\n out=subprocess.check_output(['systemctl','--user','show',unit,'-p','MainPID','-p','ActiveState','-p','SubState','-p','ControlGroup','-p','Result'],text=True)\n return dict(line.split('=',1) for line in out.splitlines() if '=' in line)\nbefore=json.loads((base/'production-before.json').read_text());prod=Path.home()/'.config/remoterf'\nservice=show('remoterf-lab.service');assert service['ActiveState']=='active'\nnow={'service_pid':service['MainPID'],'versions':{n:version(n) for n in before['versions']},\n 'inventory_sha256':hashlib.sha256((prod/'devices.yml').read_bytes()).hexdigest(),'integration_config_present':(prod/'integrations.json').exists()}\nassert now==before\nunits={}\nfor name in ('server','descendant'):\n unit='remoterf-phase1c-e2e-'+name+'-20261110.service';v=show(unit)\n assert v['MainPID']=='0' and not v['ControlGroup'] and v['Result']=='success'\n units[unit]=v\nfor path,key in ((base/'server-guardian-v4/ready.json','root'),(base/'descendant/guardian-evidence.json','guarded_root')):\n value=json.loads(path.read_text())[key];root=Path(value['root'] if isinstance(value,dict) else value);assert not root.exists()\nc=base/'service/config/remoterf';assert yaml.safe_load((c/'devices.yml').read_text())['devices']==[]\nassert json.loads((c/'integrations.json').read_text())['enabled'] is False\nfor p,key in ((c/'db/integrations/ownership/ownership.json',None),(c/'db/integrations/processes/scopes.json','scopes'),\n (base/'server-guardian-v4/processes/scopes.json','scopes'),(base/'descendant/run/ownership/ownership.json',None),(base/'descendant/run/processes/scopes.json','scopes')):\n value=json.loads(p.read_text());assert (value[key] if key else value)=={}\nusb=[]\nfor p in Path('/sys/bus/usb/devices').glob('*/serial'):\n try:\n  if p.read_text().strip()=='32C78EE':usb.append(p.parent)\n except OSError:pass\nassert len(usb)==1\nd=usb[0];node=Path('/dev/bus/usb')/('%03d'%int((d/'busnum').read_text()))/('%03d'%int((d/'devnum').read_text()))\nquery=subprocess.run(['fuser',str(node)],capture_output=True,timeout=2)\nassert query.returncode==1 and not query.stdout.strip() and not query.stderr.strip()\nidentity=json.loads((artifacts/'installed-identity.json').read_text());site=artifacts/'env/lib/python3.12/site-packages';wheels={}\nfor name,record in identity['wheel_identity'].items():\n wheel=artifacts/name;assert hashlib.sha256(wheel.read_bytes()).hexdigest()==record['sha256'];count=0\n with zipfile.ZipFile(wheel) as archive:\n  for member in archive.namelist():\n   if member.endswith('/') or '.dist-info/' in member:continue\n   assert (site/member).read_bytes()==archive.read(member),member\n   count+=1\n wheels[name]={'sha256':record['sha256'],'packaged_files_matched':count}\nassert sum(v['packaged_files_matched'] for v in wheels.values())==209\nresult={'passed':True,'observed_at':time.time(),'production':now,'production_unchanged':True,\n 'units':units,'owned_cgroup_roots_absent':True,'persisted_hardware_and_process_journals_empty':True,\n 'private_canary_disabled':True,'private_inventory_empty':True,'observable_usb_owners':0,\n 'usb_observation_scope':'current uid only','cross_uid_usb_owners_observed':False,'usb_node':str(node),\n 'exact_wheels':wheels,'production_integrations_enabled':False,'production_push_or_publication':False}\nwith (base/'final-state.json').open('x') as output:json.dump(result,output,indent=2);output.write('\\n')\nprint(json.dumps(result))\n",
